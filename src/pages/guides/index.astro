---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
import { GUIDES } from '../../lib/guides';
const ld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'PluginLint guides',
  itemListElement: GUIDES.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.title, url: new URL(u(`/guides/${g.slug}/`), Astro.site).toString() })),
};
---
<Base title="ChatGPT Plugin Submission Guides" description="Sourced, plain-English guides to ChatGPT plugin submission: rejection reasons, error codes, MCP tool annotations, test cases, name limits, screenshots." jsonLd={ld} crumbName="Guides">
  <h1>Guides</h1>
  <p class="lede">Short, sourced explanations of the ChatGPT plugin directory rules. Each guide starts with a one-paragraph answer, links to the OpenAI page it is based on, and shows when it was last checked.</p>
  {GUIDES.map((g) => <div class="card"><h2 style="margin-top:0"><a href={u(`/guides/${g.slug}/`)}>{g.title}</a></h2><p>{g.blurb}</p></div>)}
  <p>Prefer to check your own listing? Use the <a href={u('/grader/')}>listing grader</a>, or see every limit on the <a href={u('/rules/')}>rules page</a>.</p>
</Base>
