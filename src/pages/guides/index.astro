---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
const guides = [
  ['/guides/plugin-name-character-limit/', 'Plugin name character limit', 'The 30-character display-name limit, the separate 64-character package name, and the naming guidelines reviewers apply.'],
  ['/guides/starter-prompts-rules/', 'Starter prompt rules', 'How many starter prompts you can add, the 128-character limit, uniqueness, @mentions, and how to write good ones.'],
  ['/guides/submission-errors-explained/', 'Submission errors explained', 'The listing-field error codes from OpenAI’s submission-errors page, grouped and translated into fixes.'],
  ['/guides/undisclosed-data-types-rejection/', 'Fixing the “undisclosed data types” rejection', 'What to remove from tool outputs (session/trace/request IDs, timestamps, internal IDs, logs, secrets) and when to disclose instead.'],
  ['/guides/mcp-test-cases/', 'Writing the 5 positive + 3 negative test cases', 'Required fields per OpenAI’s submission schema and how to write cases reviewers can verify.'],
  ['/guides/screenshot-size-requirements/', 'Screenshot size requirements', 'When screenshots are allowed, the 706 px width and 400–860 px height rule, and how to resize.'],
];
---
<Base title="Guides" description="Plain-English guides to the ChatGPT plugin directory listing rules: name limits, starter prompts, submission errors and screenshot sizes.">
  <h1>Guides</h1>
  <p class="lede">Short, sourced explanations of the listing rules. Each guide links to the OpenAI page it is based on and shows when it was last checked.</p>
  {guides.map(([href, t, d]) => <div class="card"><h2 style="margin-top:0"><a href={u(href)}>{t}</a></h2><p>{d}</p></div>)}
</Base>
