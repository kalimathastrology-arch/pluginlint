---
import { SITE_NAME, SITE_TAGLINE, ANALYTICS_SCRIPT_URL } from '../../site.config.mjs';
import { u } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  type?: 'website' | 'article';
}
const { title, description, jsonLd, type = 'website' } = Astro.props;
const fullTitle = title === SITE_NAME ? `${SITE_NAME} — ${SITE_TAGLINE}` : `${title} | ${SITE_NAME}`;
const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).toString();
const siteLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME,
  url: new URL(u('/'), Astro.site).toString(), description: SITE_TAGLINE,
};
const ld = [siteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const nav = [
  ['/grader/', 'Grader'], ['/tools/', 'Tools'], ['/rules/', 'Rules'], ['/guides/', 'Guides'], ['/about/', 'About'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#1a56db" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="PluginLint rules changes" href={u('/rss.xml')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {ANALYTICS_SCRIPT_URL && <script defer src={ANALYTICS_SCRIPT_URL}></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap row">
        <a class="brand" href={u('/')}>Plugin<span>Lint</span></a>
        <nav aria-label="Main">
          {nav.map(([href, label]) => <a href={u(href)}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>PluginLint</strong> is an independent, free project. Not affiliated with, endorsed by, or sponsored by OpenAI. “ChatGPT” and “OpenAI” are trademarks of OpenAI.</p>
        <p>
          <a href={u('/privacy/')}>Privacy</a> · <a href={u('/submit/')}>Submit feedback</a> ·
          <a href={u('/rss.xml')}>RSS: rules changes</a> · <a href={u('/sitemap-index.xml')}>Sitemap</a>
        </p>
      </div>
    </footer>
  </body>
</html>
